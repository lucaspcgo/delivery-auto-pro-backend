# Banco de dados e cache
DATABASE_URL=postgres://usuario:senha@host:5432/banco
REDIS_URL=redis://host:6379

# Porta do servidor (opcional, padrão 3001)
PORT=3001

# Segredo para assinar os JWT — OBRIGATÓRIO, mínimo 32 caracteres aleatórios.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-valor-aleatorio-de-64-caracteres-ou-mais
# Validade do token (opcional, padrão 24h)
JWT_EXPIRES_IN=24h

# CORS: lista de origens permitidas separadas por vírgula (opcional).
# Se vazio, aceita qualquer origem. Ex.: https://app.seudominio.com,https://painel.lovable.app
ALLOWED_ORIGINS=

# Credenciais iFood (Merchant API)
IFOOD_CLIENT_ID=seu-client-id-aqui
IFOOD_CLIENT_SECRET=seu-client-secret-aqui

# Credenciais 99Food
FOOD99_APP_ID=seu-app-id-aqui
FOOD99_APP_SECRET=seu-app-secret-aqui
# URL de autorização do seu app no 99Food (o link que a loja abre para autorizar)
FOOD99_AUTHORIZE_URL=https://merchant.99app.com/pt-BR/manager/app-authorize?app_id=...

# true = aplica gating de planos; false/vazio = passthrough (nada bloqueado)
PLAN_GATING_ENABLED=false
